{{/* Rendered once by `chezmoi init` into the
     machine-local config (~/.config/chezmoi/chezmoi.toml). Never committed.

     Bundles are one multi-select, not one yes/no each: one question per
     bundle is easy to click through and miss, and a typed list would
     silently disable whatever was misspelled. A multichoice shows every
     option at once and rejects anything not on the list. The booleans below
     are computed from the answer, so every `.bundles.<name>` gate elsewhere
     is unaffected. */}}
{{- $bundles := list "ops" "media" "playwright" "work" "go" "java" "rust" "ai" "hindsight" -}}
{{- $name := promptStringOnce . "name" "Git name for this machine" -}}
{{- $email := promptStringOnce . "email" "Git email for this machine" -}}
{{- $bwServer := promptStringOnce . "bwServer" "Bitwarden server URL (machine-local, never committed)" -}}
{{- $secretsDir := promptStringOnce . "secretsDir" "Absolute path of the machine-local secrets directory, no trailing slash, no regex metacharacters (machine-local, never committed)" -}}
{{- /* The empty defaults list is deliberate: nothing starts ticked, so every
       enabled bundle is one you chose. A pre-ticked list is as easy to accept
       wholesale as one yes/no prompt per bundle was to click through. */ -}}
{{- $chosen := promptMultichoiceOnce . "bundleList" "Bundles to enable" $bundles (list) -}}
{{- $hindsightPaths := "" -}}
{{- if has "hindsight" $chosen -}}
{{-   $hindsightPaths = promptStringOnce . "hindsightPaths" "Hindsight paths for this machine: comma-separated prefixes, `*` for all, empty for none (machine-local, never committed)" -}}
{{- end -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    bwServer = {{ $bwServer | quote }}
    secretsDir = {{ $secretsDir | quote }}
    bundleList = [{{ range $i, $b := $chosen }}{{ if $i }}, {{ end }}{{ $b | quote }}{{ end }}]
{{- if has "hindsight" $chosen }}
    hindsightPaths = {{ $hindsightPaths | quote }}
{{- end }}

[data.bundles]
{{ range $bundles }}    {{ . }} = {{ has . $chosen }}
{{ end }}
[bitwarden]
    unlock = "auto"
