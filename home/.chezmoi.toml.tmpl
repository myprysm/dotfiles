{{/* Rendered once by `chezmoi init` into the
     machine-local config (~/.config/chezmoi/chezmoi.toml). Never committed.

     Bundles are one multi-select, not one yes/no each: eight sequential
     questions are easy to click through and miss, and a typed list would
     silently disable whatever was misspelled. A multichoice shows every
     option at once and rejects anything not on the list. The booleans below
     are computed from the answer, so every `.bundles.<name>` gate elsewhere
     is unaffected. */}}
{{- $bundles := list "ops" "media" "playwright" "work" "go" "java" "rust" "ai" -}}
{{- $email := promptStringOnce . "email" "Git email for this machine" -}}
{{- $bwServer := promptStringOnce . "bwServer" "Bitwarden server URL (machine-local, never committed)" -}}
{{- $chosen := promptMultichoiceOnce . "bundleList" "Bundles to enable" $bundles -}}

[data]
    email = {{ $email | quote }}
    bwServer = {{ $bwServer | quote }}
    bundleList = [{{ range $i, $b := $chosen }}{{ if $i }}, {{ end }}{{ $b | quote }}{{ end }}]

[data.bundles]
{{ range $bundles }}    {{ . }} = {{ has . $chosen }}
{{ end }}
[bitwarden]
    unlock = "auto"
