# Always a template. Patterns match TARGET paths.
# Per-machine escape hatch + zsh runtime artifacts
.zshrc.local
.zcompdump*

# Never a managed target, and the ignore is the point: a history file records
# every credential ever typed at a prompt, and this repo is public. 30-mcfly.zsh
# seeds it at 600 so McFly's readability check passes on a fresh machine
# (chezmoi's own `create_` would work, but leaves the path add-able: a single
# `chezmoi add ~/.zsh_history` replaces the empty stub with the live file,
# verbatim, and reports nothing). Ignored, `chezmoi add` refuses it outright.
.zsh_history

# Source data, never a managed target. The skills CLI owns this file and stamps
# updatedAt on every install, so a managed copy can never converge: it reports
# drift forever and stops `chezmoi apply` with an overwrite prompt, which breaks
# unattended apply. 50-claude-skills reads it out of the SOURCE state via
# `include`, so ignoring the target costs nothing. Refresh the tracked copy by
# writing to home/dot_agents/dot_skill-lock.json directly — `chezmoi add` will
# not touch an ignored path.
.agents/.skill-lock.json

# Runtime state written by the tool inside a managed external. Externals are
# expanded into the target and every one of ours is `exact = true`, so chezmoi
# deletes whatever it did not write: a file the tool creates at runtime is
# either wiped silently or, once chezmoi has recorded it, stops `chezmoi apply`
# with a "has changed since chezmoi last wrote it" prompt. Ignoring the target
# path is the only fix — an `exclude =` on the external filters the archive but
# does NOT stop exact-removal (verified: it deletes them without asking).
# Pattern is `<dir>/*`, not `<dir>/**`: the trailing `*` keeps the directory
# itself in the target state (tools that never mkdir it still find it) while
# ignoring everything, at any depth, underneath.
.oh-my-zsh/cache/*
.oh-my-zsh/log/*
.vim_runtime/temp_dirs/undodir/*

{{ if ne .chezmoi.os "darwin" -}}
# darwin-only targets. gnu-tools-path.zsh used to be listed here and never
# existed in the source: macOS keeps its BSD userland on PATH and the GNU
# formulae stay reachable as gsed/gcp, which is why the scripts are written
# portably (#30 used awk rather than GNU `sed -i`) instead of shadowing them.
Library/**
.config/zsh/env.d/openblas.zsh
.config/zsh/env.d/25-darwin-build.zsh
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
# linux-only targets
.config/k9s/**
{{- end }}

{{ if not .bundles.ops -}}
.config/zsh/env.d/helm3-pin.zsh
{{- end }}

{{ if not .bundles.work -}}
# openblas and mysql-client are work-bundle formulae, so their env belongs to
# that bundle too — a darwin-only gate alone would export build flags pointing
# at an uninstalled keg. mysql-client is keg-only, hence the explicit PATH.
.config/zsh/env.d/openblas.zsh
.config/zsh/env.d/45-mysql-client.zsh
.config/zsh/env.d/46-libpq.zsh
{{- end }}

{{ if not .bundles.rust -}}
.config/zsh/env.d/20-cargo.zsh
{{- end }}

{{ if not (index .bundles "java") -}}
.config/zsh/rc.d/50-sdkman.zsh
{{- end }}
