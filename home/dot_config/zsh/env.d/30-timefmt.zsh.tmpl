# `time` output format. The memory unit is the only value that varies by OS
# (#4 §3: .tmpl is reserved for single-value variance).
MAX_MEMORY_UNITS={{ if eq .chezmoi.os "darwin" }}KB{{ else }}MB{{ end }}

TIMEFMT='%J   %U  user %S system %P cpu %*E total'$'\n'\
'avg shared (code):         %X KB'$'\n'\
'avg unshared (data/stack): %D KB'$'\n'\
'total (sum):               %K KB'$'\n'\
'max memory:                %M '$MAX_MEMORY_UNITS''$'\n'\
'page faults from disk:     %F'$'\n'\
'other page faults:         %R'
