#!/bin/sh
# Estate-wide pre-commit secret scan (#18). core.hooksPath points every repo on
# this machine here, which SHADOWS each repo's own .git/hooks — so this chains
# to the local pre-commit hook once the scan passes.
#
# gitleaks is resolved absolutely first: git launched from a GUI client
# inherits no `brew shellenv`, the same wall that forces gpg.program absolute
# in .gitconfig. `command -v` is the fallback for a non-brew install.
set -eu

GITLEAKS="{{ template "brew-prefix" . }}/bin/gitleaks"
if [ ! -x "$GITLEAKS" ]; then
  GITLEAKS="$(command -v gitleaks 2>/dev/null || true)"
fi

if [ -z "$GITLEAKS" ] || [ ! -x "$GITLEAKS" ]; then
  echo "FATAL: gitleaks is not installed — refusing to commit." >&2
  echo "       This machine's pre-commit secret scan cannot run." >&2
  echo "       brew install gitleaks" >&2
  echo "       (bypass, deliberately: git commit --no-verify)" >&2
  exit 1
fi

# --redact: a finding is printed to a terminal, into scrollback and into any
# agent transcript reading it. File, line and rule are enough to act on.
if ! "$GITLEAKS" git --pre-commit --staged --no-banner --redact; then
  echo "gitleaks found a secret in the staged diff — commit refused." >&2
  exit 1
fi

# Redaction scan (#41), only in a repo that tracks the marker. It flags shape
# classes, never an identifier: a rule naming a real host or user would
# publish it. Placeholders are allowlisted below; a real value is rewritten,
# not added here. The value is not printed, for the --redact reason above.
TOP="$(git rev-parse --show-toplevel)"
if [ -f "$TOP/.redaction-check" ]; then
  DIFF="$(mktemp)"
  if ! git diff --cached --no-color --no-ext-diff --unified=0 --diff-filter=ACMR \
      --src-prefix=a/ --dst-prefix=b/ > "$DIFF"; then
    rm -f "$DIFF"
    echo "FATAL: the redaction scan could not read the staged diff — refusing to commit." >&2
    exit 1
  fi
  rc=0
  awk '
    /^\+\+\+ / { f = substr($0, 7); next }
    /^@@ / { split($3, a, ","); n = substr(a[1], 2) + 0; next }
    /^\+/ {
      s = " " substr($0, 2)
      while (match(s, /[^A-Za-z0-9_.}\/-](\/home|\/Users)\/[A-Za-z0-9._-]+|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z][A-Za-z]+|~\/\.ssh\/[A-Za-z0-9._-]+/)) {
        v = substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        if (v ~ /^.\/(home|Users)\//) {
          c = "absolute home path"
          v = substr(v, 2)
          if (v ~ /^\/(home|Users)\/(OPERATOR|x|u|you)$/ || v == "/home/linuxbrew") continue
        } else if (v ~ /^~/) {
          c = "~/.ssh path"
          if (v == "~/.ssh/config") continue
        } else {
          c = "email address"
          if (v ~ /@(([A-Za-z0-9-]+\.)*example\.(com|org|net)|.*\.(example|invalid|test|localhost))$/) continue
        }
        print f ":" n ": " c > "/dev/stderr"
        hit = 1
      }
      n++
    }
    END { exit hit }
  ' "$DIFF" || rc=$?
  rm -f "$DIFF"
  if [ "$rc" -ne 0 ]; then
    echo "redaction scan: identifier-shaped value staged — commit refused." >&2
    echo "       Rewrite it to the OPERATOR placeholder (docs/secrets.md rule 6)." >&2
    exit 1
  fi
fi

# Dispatch to the repo's own pre-commit is _chain's job, not a second copy of
# it here. HOOK_NAME because $0 would otherwise read `_chain`.
HOOK_NAME=pre-commit exec "$(dirname "$0")/_chain" "$@"
