# Managed by chezmoi (PROTOTYPE, wayfinder #7). Edit: `chezmoi edit ~/.zshrc`.
# Fixed skeleton (issue #4): all real content lives in ~/.config/zsh/*.d/.
ZSH_DROPINS="$HOME/.config/zsh"

# 1 — environment (PATH, exports), pre-omz
for f in "$ZSH_DROPINS"/env.d/*.zsh(N); do source "$f"; done

# 2 — completions, pre-compinit
fpath+=("$ZSH_DROPINS/completions.d")

# 3 — oh-my-zsh (pinned external; compinit runs inside)
export ZSH="$HOME/.oh-my-zsh"
DISABLE_AUTO_UPDATE=true
plugins=({{ index .zsh.plugins .chezmoi.os | join " " }}{{ if hasKey . "zshPluginsExtra" }} {{ .zshPluginsExtra | join " " }}{{ end }})
source "$ZSH/oh-my-zsh.sh"

# 4 — aliases
for f in "$ZSH_DROPINS"/aliases.d/*.zsh(N); do source "$f"; done

# 5 — tool hooks (starship, direnv, mcfly, …), last
for f in "$ZSH_DROPINS"/rc.d/*.zsh(N); do source "$f"; done

# per-machine escape hatch — untracked, never synced
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
