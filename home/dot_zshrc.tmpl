# Managed by chezmoi. Edit: `chezmoi edit ~/.zshrc`.
# Fixed skeleton: all real content lives in ~/.config/zsh/*.d/.
ZSH_DROPINS="$HOME/.config/zsh"

# 1 — environment (PATH, exports), pre-omz.
# INTERACTIVE ONLY, and deliberately so: zsh reads .zshrc for interactive
# shells, so nothing below reaches `zsh -c`, a script, cron (runs sh) or a
# systemd unit (runs no shell at all). Moving env.d to .zshenv would fix the
# first two and break more: .zshenv runs BEFORE .zprofile, so the four files
# expanding $HOMEBREW_PREFIX would expand it empty — the ghost-PATH bug again.
# A non-interactive consumer sets its own PATH.
for f in "$ZSH_DROPINS"/env.d/*.zsh(N); do source "$f"; done

# 2 — completions, pre-compinit
fpath+=("$ZSH_DROPINS/completions.d")

# 3 — oh-my-zsh (pinned external; compinit runs inside)
export ZSH="$HOME/.oh-my-zsh"
DISABLE_AUTO_UPDATE=true
{{/* Composed, not one list: per-OS base, then each enabled bundle's plugins,
     then this machine's extras, then the two that must come last. `range` over
     a map iterates in sorted key order, so the result is deterministic. */ -}}
plugins=({{ index .zsh.plugins .chezmoi.os | join " " }}{{ range $name, $list := .zsh.plugins.bundles }}{{ if index $.bundles $name }} {{ $list | join " " }}{{ end }}{{ end }}{{ if hasKey . "zshPluginsExtra" }} {{ .zshPluginsExtra | join " " }}{{ end }} {{ .zsh.plugins.last | join " " }})
source "$ZSH/oh-my-zsh.sh"

# 4 — aliases
for f in "$ZSH_DROPINS"/aliases.d/*.zsh(N); do source "$f"; done

# 5 — tool hooks (starship, direnv, mcfly, …), last
for f in "$ZSH_DROPINS"/rc.d/*.zsh(N); do source "$f"; done

# per-machine escape hatch — untracked, never synced
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
