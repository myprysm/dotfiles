# Managed by chezmoi. There is deliberately no `signingkey` here: each machine
# signs with its own key (#48), so the id is per-machine and belongs in the
# ~/.gitconfig.local include at the bottom of this file. Rendering it from the
# vault named a key the other machine's keyring held (#50).
[user]
    name = Damien benon
    email = {{ .email }}
[commit]
    gpgsign = true
[tag]
    gpgsign = true
{{- if eq .chezmoi.os "linux" }}
[gpg]
{{- if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
    # WSL: the secret key lives in the Windows GnuPG store, reached through
    # this symlink to gpg.exe. Per-OS logic, not a secret.
    program = /usr/local/bin/gpg
{{- else }}
    program = gpg
{{- end }}
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
[gpg]
    # Absolute rather than PATH-resolved. macOS ships no gpg, so this is brew's,
    # and git launched from a GUI client (JetBrains, VS Code) inherits no
    # `brew shellenv` — a bare `gpg` signs fine in a terminal and fails there.
    # The prefix comes from .chezmoitemplates/brew-prefix, which is the one
    # place the Apple Silicon / Intel split is written down.
    program = {{ template "brew-prefix" . }}/bin/gpg
{{- end }}
[core]
    excludesfile = ~/.config/git/ignore
    # Estate-wide gitleaks pre-commit scan (#18). Every repo on the machine,
    # because a secret leaks the same from any of them and this costs no
    # per-clone step. It SHADOWS each repo's own .git/hooks, so the hooks here
    # chain to the local hook of the same name; a repo setting its own LOCAL
    # core.hooksPath (husky) overrides this and is untouched.
    hooksPath = ~/.config/git/hooks
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[rebase]
    autoStash = true
[alias]
    fo = "!f() { git fetch origin \"$1\":\"$1\"; }; f"
# Per-machine escape hatch, untracked and never synced — the .zshrc.local
# pattern for git. This is where identity-bearing and work-specific settings go:
# core.sshCommand pinning a key by filename, includeIf blocks for work project
# trees, safe.directory. git ignores a missing include path, so a machine
# without the file is unaffected. Last, so local settings win.
[include]
    path = ~/.gitconfig.local
