{{- /* chezmoi:modify-template */ -}}
{{- /*
The Bitwarden restore writes this whole file with only the credentials and
"optInOnly", so it removes every key set here. Run chezmoi apply after each
restore (#128).

An empty or absent hindsightPaths still sets optInOnly: the switch fails
closed (#141). A "~" stays as typed: the runtime expands it in optInPaths.
*/ -}}
{{- $live := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $live = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $answer := trim (toString (get . "hindsightPaths")) -}}
{{- $paths := list -}}
{{- range splitList "," $answer -}}
{{-   if trim . -}}
{{-     $paths = append $paths (trim .) -}}
{{-   end -}}
{{- end -}}
{{- $_ := unset $live "optInPaths" -}}
{{- if eq $answer "*" -}}
{{-   $_ := unset $live "optInOnly" -}}
{{- else -}}
{{-   $_ := set $live "optInOnly" true -}}
{{-   if $paths -}}
{{-     $_ := set $live "optInPaths" $paths -}}
{{-   end -}}
{{- end -}}
{{- $_ := unset $live "customPages" -}}
{{- $_ := set $live "bankId" "damien-main-memory" -}}
{{- $_ := set $live "manageBankConfig" false -}}
{{- $_ := set $live "pages" (dict "Component map" false "Core concepts" false "Conventions and patterns" false "Key decisions and rationale" false "Initiatives and enhancements" false) -}}
{{- $_ := set $live "retainTags" (list "project:{gitProject}") -}}
{{- $_ := set $live "retainMetadata" (dict "repo" "{gitProject}") -}}
{{- $_ := set $live "autoSeed" false -}}
{{- $_ := set $live "gitIngest" "none" -}}
{{- $_ := set $live "codebaseSurvey" false -}}
{{- $_ := set $live "autoUpdate" false -}}
{{- $_ := set $live "pageTriggerType" "manual" -}}
{{- $_ := set $live "toolGuideExtra" "Never call hindsight_capture_initiative, and never create a knowledge page or a mental model, even after the user approves a plan. The operator curates the page set by hand; its backlog is the hindsight-mental-models map in ~/projects/myprysm/infrastructure/.wayfinder/. If a topic looks durable enough for its own page, say so in the conversation: give a title, the question the page would answer, and why the topic will last. The operator decides." -}}
{{- /* The default "reflect" timed out at 20 s on every session against this
       server and cost about 27 s in the prompt hook before its recall fallback
       (#127). */ -}}
{{- $_ := set $live "autoInject" "recall" -}}
{{ toPrettyJson $live }}
