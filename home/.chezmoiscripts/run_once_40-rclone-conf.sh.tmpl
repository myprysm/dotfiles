#!/bin/bash
# rclone.conf assembled whole-file from per-domain
# secure-note fragments. Generic ref names only — no remote names in this repo.
# INI sections are independent, so concatenation is safe.
# Item names come from .chezmoidata/secrets.yaml, same map the
# template router uses; the personal/work pair deliberately shares one ref name.
set -eu
mkdir -p "$HOME/.config/rclone"
umask 077

dest="$HOME/.config/rclone/rclone.conf"

# Assembled into a temp file, never straight into place. `{ … } > "$dest"` reads
# as "write the config", but bash truncates the target when it sets the redirect
# up — before a single vault command has run — so any failure (locked vault, an
# unseeded work item, no network) left a truncated or empty rclone.conf behind.
# That is unrecoverable: these remotes carry keys that may exist nowhere else.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

: > "$tmp"

# A fragment whose last line has no newline would glue that line onto the next
# fragment's opening `[section]`, silently losing a remote. `bw get notes` emits
# no trailing newline (`op read` does), so the personal fragment always needs
# this and it is the concatenation boundary that depends on it (#53).
end_with_newline() {
  [ -s "$1" ] || return 0
  [ -z "$(tail -c1 "$1")" ] || printf '\n' >> "$1"
}

# The personal fragment is the base: failing to read it IS fatal, because the
# result would be a config missing the remotes this machine depends on.
if ! bw get notes {{ (index .secrets "rclone-conf-personal").ref | quote }} >> "$tmp"; then
  echo "FATAL: could not read the personal rclone fragment from bw." >&2
  echo "       Is the vault unlocked? $dest left untouched." >&2
  exit 1
fi

# The exit status alone is not enough. When bw's prompt library cannot use the
# terminal it prints nothing and still exits 0 — #19 measured that for the
# secrets scripts, and `chezmoi apply -v` reproduces it here, because it captures
# this script's stdout so the prompt has nowhere to attach. The whole-file `-s`
# test below cannot catch it either: the work fragment keeps the file non-empty.
# Unchecked, a fresh machine got a work-only config at mode 600 and the word
# "restored" (#53). The section header is what a fragment must have, not bytes.
if ! grep -q '^\[' "$tmp"; then
  echo "FATAL: the personal rclone fragment came back with no remote in it." >&2
  echo "       bw exited 0 and printed nothing, which is what it does when it" >&2
  echo "       cannot prompt on a terminal — 'chezmoi apply -v' does this." >&2
  echo "       Unlock the vault, then run 'chezmoi apply' without -v." >&2
  echo "       $dest left untouched." >&2
  exit 1
fi
end_with_newline "$tmp"

{{- if .bundles.work }}
# The work fragment is best-effort, and the test is whether the READ succeeds —
# not whether op is installed. Testing the binary was not enough: on a machine
# that has op but whose work vault has not been seeded yet (#47 owns that), the
# read fails, and under `set -e` that aborted the whole script. Because
# .chezmoiscripts sorts ahead of .claude/.config/.zshrc, aborting here meant
# chezmoi never reached the file phase at all — a missing work fragment stopped
# the entire migration, which is the opposite of the intent recorded below.
#
# Intent, unchanged: a machine that cannot reach the work vault should still end
# up with its personal remotes rather than no rclone.conf at all. This mirrors
# work_domain_ready in secrets-common.sh. The file is written once, so seeding
# the work fragment also changes this script, which re-runs and picks it up then.
#
# The read is BOUNDED, because op can block rather than fail: with the desktop
# app integration it raises an approval prompt and waits about two minutes before
# giving up. Unbounded, an unattended `chezmoi apply` stalls there for no gain.
# coreutils cannot be assumed — run_once_ sorts ahead of run_onchange_, so on a
# fresh machine this runs before the brew installer — hence the fallback.
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
op_read() {
  if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" 45 op read "$1"; else op read "$1"; fi
}
# Read into its OWN file and validate before appending. Appending straight to
# $tmp meant an `op` that exited 0 while printing prose — a sign-in nag, or an
# empty note — put that sentence into rclone.conf as a live config line, and the
# script still reported "restored". The personal fragment has had a section-header
# test since #53; the work fragment never got one, so the same wrong-success shape
# survived on this side. It stays BEST-EFFORT: a bad fragment is dropped with a
# warning, never a fatal, for the reasons recorded above.
work_frag="$(mktemp)"
trap 'rm -f "$tmp" "$work_frag"' EXIT
if ! command -v op >/dev/null 2>&1; then
  echo "  ! op not installed — work remotes omitted from rclone.conf" >&2
elif ! op_read {{ printf "op://Employee/%s/notesPlain" (index .secrets "rclone-conf-work").ref | quote }} > "$work_frag" 2>/dev/null; then
  echo "  ! work rclone fragment not readable — omitted from rclone.conf" >&2
  echo "  !   expected a note at op://Employee/<ref>/notesPlain. Either the work" >&2
  echo "  !   vault has no such note yet, or op's authorization prompt went" >&2
  echo "  !   unapproved — unlock 1Password and re-run to pick the work remotes up." >&2
elif ! grep -q '^\[' "$work_frag"; then
  echo "  ! the work rclone fragment carries no remote — omitted." >&2
  echo "  !   op exited 0 but returned no INI section, which is what it does when" >&2
  echo "  !   it prints a sign-in notice instead of the note. Your personal remotes" >&2
  echo "  !   are unaffected. Unlock 1Password and re-run to pick the work ones up." >&2
else
  cat "$work_frag" >> "$tmp"
  end_with_newline "$tmp"
fi
{{- end }}

[ -s "$tmp" ] || {
  echo "FATAL: the vault produced an empty rclone.conf. $dest left untouched." >&2
  exit 1
}

if [ ! -e "$dest" ]; then
  cp "$tmp" "$dest"
  chmod 600 "$dest"
  echo "  rclone.conf restored from the vault ($(grep -c '^\[' "$dest") remotes)"
elif cmp -s "$tmp" "$dest"; then
  echo "  rclone.conf already matches the vault"
else
  # An existing config is never replaced. The fragments are seeded from whichever
  # machine wrote them, so on a second machine the two can legitimately differ,
  # and picking a winner automatically means silently dropping remotes from one
  # side. Write beside it and let a human reconcile.
  cp "$tmp" "$dest.from-vault"
  chmod 600 "$dest.from-vault"
  echo "  ! $dest exists and differs from the vault." >&2
  # Section counts alone read as a contradiction when the difference is format:
  # #53 met `on disk: 8 remotes    vault: 8 remotes` and had to establish by hand
  # that the remotes were identical and only the line endings and section order
  # differed. Line-set equality separates the two cases. Remote names stay out of
  # the message: the operator pastes this log into a public issue.
  if [ "$(tr -d '\r' < "$dest" | sort)" = "$(sort < "$tmp")" ]; then
    echo "  !   FORMAT only: same remotes, same values, different line endings" >&2
    echo "  !   or section order. Nothing is missing from either side." >&2
  else
    echo "  !   CONTENT differs. on disk: $(grep -c '^\[' "$dest") remotes    vault: $(grep -c '^\[' "$tmp") remotes" >&2
  fi
  echo "  ! wrote $dest.from-vault instead; nothing was overwritten." >&2
  echo "  ! reconcile by hand, re-seed the vault, then delete the .from-vault copy." >&2
fi
