#!/bin/bash
# One Brewfile rendered from .chezmoidata/packages.yaml (core + per-OS +
# enabled bundles) piped to brew bundle.
# Any list edit changes this rendered script → run_onchange_ re-runs it.
set -eu

# Homebrew 6 downloads in parallel (default: twice the CPU count) and its
# download cache is not safe under that concurrency: two fetches race on the
# same `*.bottle_manifest.json.incomplete` entry and one dies with
# `dir_s_rmdir ... No such file or directory`. brew then reports the formula
# as failed even though it poured and installed correctly, `brew bundle` exits
# non-zero, and the whole apply dies with it. Seen twice on fresh machines, on
# unrelated formulae each time. Serialising downloads costs some wall-clock on
# a first install and buys a bootstrap that does not fail at random.
export HOMEBREW_DOWNLOAD_CONCURRENCY=1

# Homebrew 6 will not load a third-party tap's formulae until the tap is
# trusted, and `brew bundle` cannot express that.
{{ range .packages.taps -}}
brew tap {{ . | quote }}
brew trust --tap {{ . | quote }}
{{ end }}
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.core.brews }}brew {{ . | quote }}
{{ end -}}
{{ range (index .packages.core .chezmoi.os).brews }}brew {{ . | quote }}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.core.darwin.casks }}cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.secret.brews }}brew {{ . | quote }}
{{ end -}}
{{ range $name, $bundle := .packages.bundles -}}
{{ if and (index $.bundles $name) (hasKey $bundle "brews") -}}
{{ range $bundle.brews }}brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
EOF
