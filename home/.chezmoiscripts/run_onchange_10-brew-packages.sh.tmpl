#!/bin/bash
# One Brewfile rendered from .chezmoidata/packages.yaml (core + per-OS +
# enabled bundles) piped to brew bundle.
# Any list edit changes this rendered script → run_onchange_ re-runs it.
set -eu

# `brew bundle` installs formulae in parallel by default (HOMEBREW_BUNDLE_JOBS
# defaults to `auto`, i.e. CPU cores capped at 4 — the --jobs help text still
# claims a sequential default, and is wrong). Those are separate brew
# PROCESSES sharing one download cache, and they race on it: one finishes a
# download and renames the `.incomplete` file while another, which had been
# waiting on it, opens the final path in the gap and dies with
# `rb_sysopen ... No such file or directory`. brew then marks the formula
# failed even though it poured, `brew bundle` exits non-zero, and the whole
# apply dies. Three fresh-machine runs, three different formulae.
# Serial installs cost wall-clock once; a bootstrap that fails at random
# costs it every time.
export HOMEBREW_BUNDLE_NO_JOBS=1

# Homebrew 6 will not load a third-party tap's formulae until the tap is
# trusted, and `brew bundle` cannot express that.
{{ range .packages.taps -}}
brew tap {{ . | quote }}
brew trust --tap {{ . | quote }}
{{ end }}
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.core.brews }}brew {{ . | quote }}
{{ end -}}
{{ range (index .packages.core .chezmoi.os).brews }}brew {{ . | quote }}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.core.darwin.casks }}cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.secret.brews }}brew {{ . | quote }}
{{ end -}}
{{ range $name, $bundle := .packages.bundles -}}
{{ if and (index $.bundles $name) (hasKey $bundle "brews") -}}
{{ range $bundle.brews }}brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
EOF
