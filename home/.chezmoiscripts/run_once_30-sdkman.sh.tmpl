{{ if index .bundles "java" -}}
#!/bin/bash
# SDKMAN owns the JDKs: brew casks cannot switch vendors.
# `index` rather than .bundles.java, because a machine whose config predates
# this bundle has no such key and a direct lookup is a template error, not false.
set -eu
[ -d "$HOME/.sdkman" ] || curl -s "https://get.sdkman.io?rcupdate=false" | bash

# Pin the manager, same stance as omz: the installer writes
# sdkman_selfupdate_feature=true (NOT sdkman_auto_selfupdate, which no longer
# exists), so flip that one key and leave SDKMAN owning the other eleven — a
# tracked copy of the whole file would silently drop any key a later SDKMAN
# adds. Rewrite in place rather than `sed -i`, which is not portable to the
# Mac's BSD sed. Append when the key is absent, so a rename upstream cannot
# turn this into a silent no-op.
config="$HOME/.sdkman/etc/config"
if grep -q '^sdkman_selfupdate_feature=' "$config"; then
    awk '/^sdkman_selfupdate_feature=/ {print "sdkman_selfupdate_feature=false"; next} {print}' \
        "$config" > "$config.tmp"
    mv "$config.tmp" "$config"
else
    echo 'sdkman_selfupdate_feature=false' >> "$config"
fi

# SDKMAN is not written to survive `set -u`: sourcing its init on a fresh
# install dies on `SDKMAN_CANDIDATES_API: unbound variable`, and `sdk` is a
# shell function from the same codebase, so it can trip the same way. An
# unbound-variable error exits the shell outright — `|| true` does not catch
# it — so the flag stays off for every line that runs SDKMAN's own code, and
# goes back on immediately afterwards.
set +u
. "$HOME/.sdkman/bin/sdkman-init.sh"
{{ range .packages.bundles.java.sdkman -}}
sdk install java {{ . }} || true
{{ end -}}
set -u
{{ end -}}
