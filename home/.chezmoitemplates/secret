{{- /* Per-domain secret router.

       Usage: {{ template "secret" (dict "ctx" . "key" "git-signing-key") }}

       The logical key resolves through .chezmoidata/secrets.yaml, so a vault
       rename is one line there and never touches a template. `ctx` carries the
       root data because an included template only sees its own argument.

       personal -> Bitwarden (bw) · work -> 1Password (op, Employee vault).
       HashiCorp Vault is the documented escape hatch: call the generic
       `output` function directly rather than routing it through here. */ -}}
{{- $s := index .ctx.secrets .key -}}
{{- $field := "value" -}}
{{- if hasKey $s "field" }}{{ $field = $s.field }}{{ end -}}
{{- if eq $s.domain "work" -}}
{{- onepasswordRead (printf "op://Employee/%s/%s" $s.ref $field) -}}
{{- else -}}
{{- index (bitwardenFields "item" $s.ref) $field "value" -}}
{{- end -}}
