#!/usr/bin/env bash
# PreToolUse hook: deny reading secret file CONTENTS via Read, Grep, or Bash.
# Carries the decision in JSON (hookSpecificOutput.permissionDecision); always exits 0.
# Depends on jq. Fails open if jq/input missing (does not break other tools).
set -u
input=$(cat)

jqr() { printf '%s' "$input" | jq -r "$1" 2>/dev/null; }
tool=$(jqr '.tool_name // empty')

case "$tool" in
  Read) target=$(jqr '.tool_input.file_path // empty') ;;
  Grep) target=$(jqr '[.tool_input.path, .tool_input.glob] | map(select(.!=null)) | join(" ")') ;;
  Bash) target=$(jqr '.tool_input.command // empty') ;;
  *)    exit 0 ;;
esac
[ -z "$target" ] && exit 0

deny() {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Reading secret files is blocked by policy (.env/.envrc, *.tfstate, kubeconfig, talosconfig, ~/.secrets, ~/.hindsight/claude-code.json, vault files). Ask the user before accessing secrets."}}'
  exit 0
}

deny_recursive() {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Recursive content search through Bash is blocked by policy: it reads files it never names, so no secret-path rule can catch it. Use the Grep tool instead - its results are filtered per matched file by the permission deny rules."}}'
  exit 0
}

deny_bypass() {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"git commit --no-verify is blocked by policy: it skips the estate-wide gitleaks pre-commit scan. If the scan reports a finding, surface it to the user - do not bypass it. The user keeps the flag in their own shell."}}'
  exit 0
}

deny_transfer() {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Transferring a secret path off this machine is blocked by policy (scp/sftp/rsync, curl/wget uploads). Secrets move through the vault (bw/op), never over a direct transfer. A local copy is not blocked - use cp/mv/tar."}}'
  exit 0
}

# Bash: ansible-vault that decrypts/exposes vault content is always blocked.
if [ "$tool" = "Bash" ]; then
  if printf '%s' "$target" | grep -Eq 'ansible-vault[[:space:]]+(view|decrypt|edit|cat|rekey)'; then
    deny
  fi

  # Recursive readers never name the file whose contents they print, so the
  # path patterns below cannot see them. Blocked as a class.
  cmd_start='(^|[|;&`(]|&&|\|\|)[[:space:]]*'
  exec_readers='(cat|head|tail|grep|egrep|rg|awk|sed|jq|yq|bat|less|more|strings|xxd|od|base64)'
  recursive_re="$cmd_start"'(grep|egrep|fgrep)[[:space:]]+([^|;&]*[[:space:]])?-[A-Za-z]*[rR]'
  recursive_re="$recursive_re|$cmd_start"'(grep|egrep|fgrep)[[:space:]]+([^|;&]*[[:space:]])?--recursive'
  recursive_re="$recursive_re|$cmd_start"'(rg|ag|ack)([[:space:]]|$)'
  recursive_re="$recursive_re"'|find[[:space:]][^|;&]*-exec[[:space:]]+'"$exec_readers"'([[:space:]]|$)'
  recursive_re="$recursive_re"'|xargs[[:space:]]([^|;&]*[[:space:]])?'"$exec_readers"'([[:space:]]|$)'
  if printf '%s' "$target" | grep -Eq "$recursive_re"; then
    deny_recursive
  fi

  # Skipping the estate-wide gitleaks pre-commit hook (#18). Checked here,
  # ABOVE the secret_re gate below: the command names no secret, so the gate
  # would let it through.
  #
  # Matched against a QUOTE-STRIPPED copy: a commit message is the one place a
  # flag-shaped string legitimately appears, and emptying quoted runs first is
  # what stops `git commit -m "document the -n flag"` from being refused.
  unquoted=$(printf '%s' "$target" | sed -E "s/'[^']*'/''/g; s/\"[^\"]*\"/\"\"/g")

  # `commit` must be the SUBCOMMAND, so only git's own global options may
  # precede it - enumerated, not "any token". Accepting any token let a literal
  # `commit` argument to another subcommand qualify, which refused read-only
  # work like `git log --grep commit -n 5`.
  git_globals='(-c[[:space:]]+[^[:space:]]+|-C[[:space:]]+[^[:space:]]+|--no-pager|--paginate|--bare|--literal-pathspecs|--icase-pathspecs|--no-replace-objects|(--git-dir|--work-tree|--namespace|--exec-path)=[^[:space:]]+)'
  # A separator glued straight to the flag (`--no-verify;echo x`, `-n&&git push`)
  # ended the command just as a space does; omitting them from this class left
  # the whole arm evadable by a character.
  flag_end='([[:space:]=;|&)]|$)'
  bypass_re="$cmd_start"'(command[[:space:]]+)?git([[:space:]]+'"$git_globals"')*[[:space:]]+commit([[:space:]][^|;&]*)?[[:space:]](--no-verify|-[A-Za-z]*n[A-Za-z]*)'"$flag_end"
  # Pointing hooksPath elsewhere skips the scan without naming --no-verify at
  # all. No legitimate agent use: the operator re-points it if they must.
  bypass_re="$bypass_re|$cmd_start"'(command[[:space:]]+)?git([[:space:]]+[^|;&]*)?[[:space:]]-c[[:space:]]+core[.]hooksPath[[:space:]]*='
  if printf '%s' "$unquoted" | grep -Eq "$bypass_re"; then
    deny_bypass
  fi
fi

# Neutralize harmless env templates so they do not trigger the .env rule,
# and Terraform templates so they do not trigger the vault.yaml rule.
scan=$(printf '%s' "$target" \
  | sed -E 's/\.env\.(example|sample|template|dist|tmpl)([^A-Za-z0-9_-]|$)/__ENVTPL__\2/g' \
  | sed -E 's/vault\.ya?ml\.(tftpl|tpl)([^A-Za-z0-9_-]|$)/__VAULTTPL__\2/g')

# Secret path / filename patterns (POSIX ERE).
#
# Split in two. These arms do not care what stands next to the name, so they are
# also matched against a QUOTE-STRIPPED copy of the text: `~/.en"v"` reaches the
# shell as the real filename, and matching only the raw text missed it.
secret_re_cf='(^|[^A-Za-z0-9_])\.env(\.[A-Za-z0-9_-]+)?([^A-Za-z0-9_.-]|$)'
secret_re_cf="$secret_re_cf"'|(^|[^A-Za-z0-9_])\.envrc([^A-Za-z0-9_-]|$)'
secret_re_cf="$secret_re_cf"'|(^|[^A-Za-z0-9_-])(kubeconfig|talosconfig)([^A-Za-z0-9_-]|$)'
secret_re_cf="$secret_re_cf"'|\.tfstate([^A-Za-z0-9]|$)'
secret_re_cf="$secret_re_cf"'|(^|[^A-Za-z0-9_])vault\.ya?ml([^A-Za-z0-9]|$)'
secret_re_cf="$secret_re_cf"'|/\.hindsight/claude-code\.json'
secret_re_cf="$secret_re_cf"'|{{ .secretsDir | replace "." "[.]" }}([^A-Za-z0-9_-]|$)'
# The two arms below DO depend on the neighbouring character - a quote in front
# of them marks a data filter rather than a filename (#69) - so they are matched
# against the raw text only, never the stripped copy.
secret_re="$secret_re_cf"
# Only in a path-like position, and never followed by a further dot. The bare
# form matched the string anywhere in a command, and 1Password's JSON carries a
# field of that name, so reading `op item get --format json` through jq was
# refused while reading no file at all — and so was the gh command that filed
# the report (#69). A preceding quote or bracket is a filter, not a filename.
secret_re="$secret_re"'|(^|[A-Za-z0-9_/~[:space:]-])\.vault([^A-Za-z0-9.]|$)'
# Same narrowing, same reason (#69): this one refused a jq read of the repo's own
# ref map, which carries reference names and no values. The trailing class keeps
# its dot, so a `.secrets.<ext>` file still matches.
secret_re="$secret_re"'|(^|[A-Za-z0-9_/~[:space:]-])\.secrets([^A-Za-z0-9_-]|$)'

# `hits_secret` is the single test every later decision uses, so the two-regex
# split cannot be applied unevenly.
hits_secret() { # 1 argument: the text to judge
  printf '%s' "$1" | grep -Eq "$secret_re" && return 0
  printf '%s' "$1" | tr -d "\"'" | grep -Eq "$secret_re_cf"
}

hits_secret "$scan" || exit 0   # no secret referenced -> allow

# Read and Grep inherently surface file contents -> block on any secret hit.
if [ "$tool" != "Bash" ]; then
  deny
fi

# Bash: a named secret handed to a transport that leaves the machine. Local
# copies (cp/mv/tar) stay allowed - they cross no boundary and a copy is only
# harmful once something reads it. curl/wget need an upload flag: without one
# they fetch INTO the machine, the opposite of the threat.
transfer_re='(^|[|;&`(]|&&|\|\|)[[:space:]]*(scp|sftp|rsync)([[:space:]]|$)'
transfer_re="$transfer_re"'|(^|[|;&`(]|&&|\|\|)[[:space:]]*(curl|wget)[[:space:]]+([^|;&]*[[:space:]])?(-T|--upload-file|-d|--data|--data-binary|--data-raw|-F|--form|--post-file)([[:space:]=]|$)'
if printf '%s' "$scan" | grep -Eq "$transfer_re"; then
  deny_transfer
fi

# Bash: only block when the command would read the secret's contents into context
# (a reader utility, POSIX source, or input redirection). Flag/path-only refs
# (e.g. `kubectl --kubeconfig`, `talosctl kubeconfig ./out`) are left alone.
#
# Whole-command patterns kept for the fallback below, and heredoc/herestring
# readers neutralised for it the way they were before the split existed.
rscan=$(printf '%s' "$scan" | sed -E 's/(cat|tac|tee|head|tail|nl|base64|sed|awk|jq|yq|grep)[[:space:]]*<<[<-]?/__HEREDOC__/g')
reader_re='(^|[|;&`(]|&&|\|\|)[[:space:]]*(cat|tac|less|more|head|tail|bat|nl|od|xxd|hexdump|strings|base64|cut|paste|sort|uniq|rev|fold|grep|egrep|fgrep|rg|ag|ack|sed|awk|gawk|mawk|jq|yq|tee|dd|view|vi|vim|nano|emacs|source)([[:space:]]|$)'
source_re='(^|[|;&`(]|&&|\|\|)[[:space:]]*\.[[:space:]]'

# ---------------------------------------------------------------------------
# Association. The two questions above were asked of the WHOLE command — "is a
# secret named?" and "is a reader present?" — and unrelated halves of one command
# answered them: a commit message that merely described a secret file, beside a
# heredoc or a `<` in its prose, was refused while it read nothing (#69). The
# command is split into its simple commands instead, and a secret must be an
# ARGUMENT OF A READER or the TARGET OF AN INPUT REDIRECTION to be denied.
#
# This FAILS CLOSED. An unbalanced quote, an unterminated heredoc or a
# substitution that never closes sets PARSE_OK=0 and denies outright. A parser
# that cannot see the command must not conclude the command is safe.
#
# KNOWN LIMITS, measured rather than assumed (#69). None is closeable by a static
# check, so they are named here instead of being implied not to exist:
#   - A path that reaches the reader through a variable: `f=<path>; cat $f`. The
#     assignment arm below catches the literal form; a path built at runtime from
#     parts, or fetched, is invisible.
#   - A filename the shell reconstructs: `$'\x2eenv'`, or a glob like `~/.en?`.
#     Quote splitting IS handled, by matching a quote-stripped copy.
#   - An interpreter given the path on its own command line in a language this
#     does not read. The word list covers the common interpreters, and a heredoc
#     fed to one is folded into its arguments, but `-c` payloads are only matched
#     as text.
# Remaining false positive: a secret filename used as a SEARCH PATTERN rather
# than an operand (`grep -n '\.env' Makefile`) is refused. Separating a pattern
# operand from a file operand needs per-tool argument grammar.
# Interpreters read whatever they are pointed at, and they also EXECUTE a heredoc
# fed to them on stdin, which is why they are named separately below as well.
INTERP_WORDS=" sh bash zsh ksh dash python python2 python3 perl ruby node php osascript "
READER_WORDS=" cat tac less more head tail bat nl od xxd hexdump strings base64 cut paste sort uniq rev fold grep egrep fgrep rg ag ack sed awk gawk mawk jq yq tee dd view vi vim nano emacs source . zcat gzcat bzcat xzcat zgrep gunzip openssl$INTERP_WORDS"
# Words that stand in FRONT of the real command. Without skipping them the
# command word of `sudo cat f` is `sudo`, and `if cat f; then` is `if` — neither
# is a reader, and both would have opened a hole the old test did not have.
PREFIX_WORDS=" command sudo env nohup time exec eval builtin xargs if then elif else do while until for select case esac fi done ! timeout gtimeout nice ionice stdbuf watch "
# A secret reaching a variable is dataflow, which no split can follow, so these
# deny on their arguments alone.
ASSIGN_WORDS=" export local declare readonly typeset set "

SIMPLES=""
SIMPLE_N=0
REDIRS=""
REDIR_N=0
PARSE_OK=1
PENDING_DELIM=""
PENDING_LIVE=0
PENDING_TABS=0
PENDING_INTERP=0
TOKEN_UNSAFE=0

flush_simple() {
  if [ -n "${buf# }" ]; then
    eval "SIMPLE_$SIMPLE_N=\$buf"
    SIMPLE_N=$((SIMPLE_N + 1))
  fi
  buf=""
}

skip_ws() {
  while [ "$i" -lt "$n" ]; do
    case ${s:i:1} in
      ' '|"$tab") i=$((i + 1)) ;;
      *) break ;;
    esac
  done
}

# One token, honouring quotes but not removing them: the narrowed patterns above
# rely on a quote staying in front of a filter expression.
read_token() {
  TOKEN=""
  TOKEN_UNSAFE=0
  local qq="" ch
  while [ "$i" -lt "$n" ]; do
    ch=${s:i:1}
    if [ -n "$qq" ]; then
      # A double-quoted token still expands, so a substitution inside one makes
      # the token unjudgeable just as it does outside. Checking only the unquoted
      # case missed `<<< "$(<secret)"`, where the read hides in the quotes.
      if [ "$qq" = '"' ]; then
        case $ch in
          '$') [ "${s:i+1:1}" = '(' ] && TOKEN_UNSAFE=1 ;;
          '`') TOKEN_UNSAFE=1 ;;
        esac
      fi
      [ "$ch" = "$qq" ] && qq=""
      TOKEN=$TOKEN$ch; i=$((i + 1)); continue
    fi
    case $ch in
      "'"|'"') qq=$ch; TOKEN=$TOKEN$ch; i=$((i + 1)) ;;
      # A backslash escapes the next character, including a newline. Without this
      # case a line continuation ended the token, so `cat < \` + newline + a path
      # captured the backslash as the redirection target and the real path became
      # a command of its own.
      '\')
        if [ "${s:i+1:1}" = "$nl" ]; then i=$((i + 2)); continue; fi
        TOKEN=$TOKEN${s:i:2}; i=$((i + 2)) ;;
      # A substitution in this position cannot be resolved statically, so the
      # token is not a filename we can judge. The caller fails closed on it.
      '$')
        if [ "${s:i+1:1}" = '(' ]; then TOKEN_UNSAFE=1; fi
        TOKEN=$TOKEN$ch; i=$((i + 1)) ;;
      '`') TOKEN_UNSAFE=1; TOKEN=$TOKEN$ch; i=$((i + 1)) ;;
      ' '|"$tab"|"$nl"|';'|'&'|'|'|')') break ;;
      *) TOKEN=$TOKEN$ch; i=$((i + 1)) ;;
    esac
  done
}

# A heredoc body is inert ONLY when the delimiter is quoted and the command being
# fed is not an interpreter. Skipping it unconditionally was a hole: an unquoted
# delimiter means the shell expands the body, so `$( … )` inside it opens files,
# and any interpreter reading the heredoc on stdin executes every line of it.
# When the body is live it is parsed as command text instead, which still leaves
# prose alone — a line of prose has no reader as its command word.
#
# `<<-` strips ALL leading tabs from the terminator, not one, and a plain `<<`
# strips none. Matching one tab in both cases refused a legitimate `<<-` body and
# accepted an indented terminator that the shell would not have accepted.
heredoc_terminator() { # 1 if the line ends the current heredoc
  local line=$1
  [ "$line" = "$PENDING_DELIM" ] && return 0
  if [ "$PENDING_TABS" -eq 1 ]; then
    while :; do
      case $line in
        "$tab"*) line=${line#"$tab"} ;;
        *) break ;;
      esac
    done
    [ "$line" = "$PENDING_DELIM" ] && return 0
  fi
  return 1
}

skip_heredoc_body() {
  local line rest_start
  while [ "$i" -lt "$n" ]; do
    rest_start=$i
    while [ "$i" -lt "$n" ] && [ "${s:i:1}" != "$nl" ]; do i=$((i + 1)); done
    line=${s:rest_start:$((i - rest_start))}
    [ "$i" -lt "$n" ] && i=$((i + 1))
    if heredoc_terminator "$line"; then
      PENDING_DELIM=""
      return 0
    fi
  done
  PARSE_OK=0
  PENDING_DELIM=""
}

# A body fed to an interpreter is not shell — it can be Python, Perl, whatever —
# so parsing it as shell associates nothing, and the interpreter still opens any
# file the body names. The body is folded into the interpreter's own arguments
# instead, which makes the existing reader test decide it.
capture_heredoc_body() {
  local line rest_start
  while [ "$i" -lt "$n" ]; do
    rest_start=$i
    while [ "$i" -lt "$n" ] && [ "${s:i:1}" != "$nl" ]; do i=$((i + 1)); done
    line=${s:rest_start:$((i - rest_start))}
    [ "$i" -lt "$n" ] && i=$((i + 1))
    if heredoc_terminator "$line"; then
      PENDING_DELIM=""; PENDING_INTERP=0
      return 0
    fi
    buf="$buf $line"
  done
  PARSE_OK=0
  PENDING_DELIM=""; PENDING_INTERP=0
}

# The body is being parsed rather than skipped, so only the terminator line is
# consumed here; everything else goes through the normal loop.
consume_terminator_if_present() {
  local line rest_start save=$i
  rest_start=$i
  while [ "$i" -lt "$n" ] && [ "${s:i:1}" != "$nl" ]; do i=$((i + 1)); done
  line=${s:rest_start:$((i - rest_start))}
  if heredoc_terminator "$line"; then
    [ "$i" -lt "$n" ] && i=$((i + 1))
    PENDING_DELIM=""
    return 0
  fi
  i=$save
  return 1
}

# A substitution suspends the quoting around it, so the quote state is stacked
# rather than tracked as one value. QSTACK holds one character per open
# substitution: the quote in force outside it, or `n` for none.
QSTACK=""
push_sub() {
  flush_simple
  QSTACK="$QSTACK${q:-n}"
  q=""
  depth=$((depth + 1))
}
pop_sub() {
  flush_simple
  [ "$depth" -gt 0 ] && depth=$((depth - 1))
  q=${QSTACK#"${QSTACK%?}"}
  [ "$q" = n ] && q=""
  QSTACK=${QSTACK%?}
}

split_command() {
  s=$1
  n=${#s}
  i=0
  buf=""
  local c nxt bt=0 delim tstart brace prev=""
  q=""; depth=0
  while [ "$i" -lt "$n" ]; do
    c=${s:i:1}
    [ "$i" -gt 0 ] && prev=${s:$((i - 1)):1}
    # Single quotes are wholly literal: nothing inside them is expanded.
    if [ "$q" = "'" ]; then
      [ "$c" = "'" ] && q=""
      buf=$buf$c; i=$((i + 1)); continue
    fi
    # Double quotes are NOT literal. A command substitution inside them is
    # expanded, so `git commit -m "$(cat <secret>)"` really does read the file,
    # and treating the quoted run as text let exactly that through.
    if [ "$q" = '"' ]; then
      case $c in
        '\') buf=$buf${s:i:2}; i=$((i + 2)); continue ;;
        '"') q=""; buf=$buf$c; i=$((i + 1)); continue ;;
        '$')
          if [ "${s:i+1:1}" = '(' ]; then push_sub; i=$((i + 2)); continue; fi
          buf=$buf$c; i=$((i + 1)); continue ;;
        '`')
          if [ "$bt" -eq 0 ]; then push_sub; bt=1; else pop_sub; bt=0; fi
          i=$((i + 1)); continue ;;
        *) buf=$buf$c; i=$((i + 1)); continue ;;
      esac
    fi
    case $c in
      "'"|'"') q=$c; buf=$buf$c; i=$((i + 1)) ;;
      '\') buf=$buf${s:i:2}; i=$((i + 2)) ;;
      '$')
        if [ "${s:i+1:1}" = '(' ]; then
          push_sub; i=$((i + 2)); continue
        fi
        # `${VAR}` is a parameter expansion, not a brace group. Letting the `{`
        # fall through to the separator case ended the simple command mid-path,
        # so `cat ${HOME}/.env` split into fragments where no reader owned the
        # filename — ordinary syntax, allowed by mistake. The whole expansion is
        # taken as one piece of the current word.
        if [ "${s:i+1:1}" = '{' ]; then
          brace=0; tstart=$i
          while [ "$i" -lt "$n" ]; do
            case ${s:i:1} in
              '{') brace=$((brace + 1)) ;;
              '}') brace=$((brace - 1)) ;;
            esac
            i=$((i + 1))
            [ "$brace" -eq 0 ] && [ "$i" -gt $((tstart + 1)) ] && break
          done
          buf=$buf${s:tstart:$((i - tstart))}
          [ "$brace" -ne 0 ] && PARSE_OK=0
          continue
        fi
        buf=$buf$c; i=$((i + 1)) ;;
      '`')
        if [ "$bt" -eq 0 ]; then push_sub; bt=1; else pop_sub; bt=0; fi
        i=$((i + 1)) ;;
      '<')
        nxt=${s:i+1:1}
        if [ "$nxt" = '(' ]; then push_sub; i=$((i + 2)); continue; fi
        if [ "$nxt" = '<' ]; then
          if [ "${s:i+2:1}" = '<' ]; then
            # A herestring's word is data, not a filename — but it is still
            # expanded, so a substitution inside it opens files. Only a word with
            # no substitution in it is skipped.
            i=$((i + 3)); tstart=$i; skip_ws; read_token
            [ "$TOKEN_UNSAFE" -eq 1 ] && i=$tstart
            continue
          fi
          i=$((i + 2))
          PENDING_TABS=0
          [ "${s:i:1}" = '-' ] && { PENDING_TABS=1; i=$((i + 1)); }
          skip_ws; read_token
          # A quoted delimiter means the body is NOT expanded. Any quoting form
          # counts, including a leading backslash, which `tr` alone missed.
          case $TOKEN in
            *"'"*|*'"'*|'\'*) PENDING_LIVE=0 ;;
            *) PENDING_LIVE=1 ;;
          esac
          delim=$(printf '%s' "$TOKEN" | tr -d "\\\\\"'")
          if [ -z "$delim" ]; then PARSE_OK=0; break; fi
          # An interpreter EXECUTES the body whatever the quoting.
          classify "$buf"
          case $INTERP_WORDS in
            *" $CMDWORD "*) PENDING_LIVE=1; PENDING_INTERP=1 ;;
          esac
          PENDING_DELIM=$delim
          continue
        fi
        i=$((i + 1)); skip_ws; read_token
        if [ "$TOKEN_UNSAFE" -eq 1 ]; then PARSE_OK=0; continue; fi
        eval "REDIR_$REDIR_N=\$TOKEN"
        REDIR_N=$((REDIR_N + 1)) ;;
      ')')
        if [ "$depth" -gt 0 ]; then pop_sub; else flush_simple; fi
        i=$((i + 1)) ;;
      # `&` is only a separator when it is not part of a redirection operator.
      # Treating it unconditionally split `cat 2>&1 <secret>` so that the
      # filename landed in a fragment whose command word was `1`.
      '&')
        case $prev in
          '>'|'<') buf=$buf$c; i=$((i + 1)) ;;
          *)
            if [ "${s:i+1:1}" = '>' ]; then buf=$buf${s:i:2}; i=$((i + 2))
            else flush_simple; i=$((i + 1)); fi ;;
        esac ;;
      ';'|'|') flush_simple; i=$((i + 1)) ;;
      # A brace is a command group only as a word of its own. `${` is handled
      # above; a `}` closing an expansion never reaches here.
      '{')
        case ${s:i+1:1} in
          ' '|"$tab"|"$nl"|'') flush_simple ;;
          *) buf=$buf$c ;;
        esac
        i=$((i + 1)) ;;
      '}')
        case $prev in
          ' '|"$tab"|"$nl"|';'|'') flush_simple ;;
          *) buf=$buf$c ;;
        esac
        i=$((i + 1)) ;;
      '(') flush_simple; i=$((i + 1)) ;;
      "$nl")
        # The interpreter case folds the body in BEFORE the flush, so the body
        # lands in the same simple command as the interpreter that runs it.
        if [ -n "$PENDING_DELIM" ] && [ "$PENDING_INTERP" -eq 1 ]; then
          i=$((i + 1)); capture_heredoc_body; flush_simple; continue
        fi
        flush_simple; i=$((i + 1))
        if [ -n "$PENDING_DELIM" ]; then
          if [ "$PENDING_LIVE" -eq 1 ]; then
            consume_terminator_if_present || :
          else
            skip_heredoc_body
          fi
        fi ;;
      *) buf=$buf$c; i=$((i + 1)) ;;
    esac
  done
  flush_simple
  [ -n "$q" ] && PARSE_OK=0
  [ "$depth" -gt 0 ] && PARSE_OK=0
  [ "$bt" -eq 1 ] && PARSE_OK=0
  [ -n "$PENDING_DELIM" ] && PARSE_OK=0
  return 0
}

# Splits one simple command into its command word and the rest. Word splitting
# does not remove quotes, so the args keep the characters the patterns need.
classify() {
  CMDWORD=""; CMDARGS=""; ASSIGNS=""
  local saved_f w skipped=0
  case $- in *f*) saved_f=on ;; *) saved_f=off ;; esac
  set -f
  set -- $1
  while [ $# -gt 0 ]; do
    w=$1
    case $w in
      [A-Za-z_]*=*) ASSIGNS="$ASSIGNS $w"; shift; continue ;;
    esac
    case $PREFIX_WORDS in
      *" $w "*) skipped=1; shift; continue ;;
    esac
    # Once a wrapper has been seen, its own options and operands are skipped too.
    # Skipping exactly one word made the OPTION the command word, so `timeout 5
    # cat f`, `sudo -u root cat f` and `command -p cat f` all read as harmless.
    if [ "$skipped" -eq 1 ]; then
      case $w in
        -*|[0-9]*) shift; continue ;;
      esac
      # An option that takes a value leaves the VALUE in the command position, so
      # `sudo -u root cat f` and `env -u FOO cat f` still read as harmless. Inside
      # a wrapper the remaining words are scanned for a reader instead: being
      # inside `sudo`/`env`/`timeout` is what makes that sound.
      case $READER_WORDS in
        *" $w "*) break ;;
      esac
      local look=$#
      while [ "$look" -gt 1 ]; do
        shift; look=$((look - 1))
        case $READER_WORDS in
          *" ${1} "*) break ;;
        esac
      done
      break
    fi
    break
  done
  CMDWORD=${1:-}
  [ $# -gt 0 ] && shift
  CMDARGS=$*
  # The command word is matched literally against a word list, so any decoration
  # defeated it: `/bin/cat`, `"cat"`, `'cat'` and `\cat` all read as non-readers.
  # Quotes and backslashes come off and a leading path goes, so the list sees the
  # program name.
  CMDWORD=$(printf '%s' "$CMDWORD" | tr -d "\"'\\\\")
  case $CMDWORD in
    */*) CMDWORD=${CMDWORD##*/} ;;
  esac
  [ "$saved_f" = off ] && set +f
  return 0
}

# Not `$(printf '\n')`: command substitution strips trailing newlines, so that
# form yields an empty string, the newline case never matches, and every heredoc
# falls through to the fallback instead of being parsed.
tab=$'\t'
nl=$'\n'
split_command "$scan"

verdict=allow
if [ "$PARSE_OK" -eq 1 ]; then
  k=0
  while [ "$k" -lt "$SIMPLE_N" ]; do
    eval "simple=\$SIMPLE_$k"
    classify "$simple"
    case $READER_WORDS in
      *" $CMDWORD "*)
        hits_secret "$CMDARGS" && verdict=deny ;;
    esac
    case $ASSIGN_WORDS in
      *" $CMDWORD "*)
        hits_secret "$CMDARGS" && verdict=deny ;;
    esac
    # A command word that itself names a secret is either reading it or running
    # it. `cat${IFS}<path>` arrives as a single word for exactly this reason.
    hits_secret "$CMDWORD" && verdict=deny
    # A copy is allowed by design, because a copy crosses no boundary — but a copy
    # whose destination is a standard stream is a read with extra steps.
    case " cp install dd cat_ " in
      *" $CMDWORD "*)
        if printf '%s' "$CMDARGS" | grep -Eq '/dev/(stdout|stderr|fd/)' \
           && hits_secret "$CMDARGS"; then verdict=deny; fi ;;
    esac
    # `git show` and `git cat-file` print file contents. The other subcommands
    # must stay allowed: a commit message naming a secret file reads nothing, and
    # denying that is the false positive this whole change exists to remove.
    if [ "$CMDWORD" = git ]; then
      case $CMDARGS in
        show*|cat-file*|"-C "*show*|"-C "*cat-file*)
          hits_secret "$CMDARGS" && verdict=deny ;;
      esac
    fi
    # A bare assignment carrying a secret path: the value goes somewhere this
    # split cannot follow, so it is treated as a read.
    if [ -n "$ASSIGNS" ] && hits_secret "$ASSIGNS"; then
      verdict=deny
    fi
    k=$((k + 1))
  done
  k=0
  while [ "$k" -lt "$REDIR_N" ]; do
    eval "redir=\$REDIR_$k"
    hits_secret "$redir" && verdict=deny
    k=$((k + 1))
  done
  [ "$verdict" = deny ] && deny
  exit 0
fi

# The split could not be trusted, and a secret IS named — control only reaches
# here past that gate. So this denies outright rather than consulting the old
# whole-command patterns: those could still answer "allow" for a shape they did
# not recognise, which made the earlier claim of failing closed untrue. A parser
# that cannot see the command must not conclude the command is safe.
deny
