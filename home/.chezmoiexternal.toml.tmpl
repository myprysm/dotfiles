# Pinned externals. refreshPeriod deliberately absent: never
# re-download unless the pin changes (or `chezmoi apply -R`). Updating = bump
# the SHA here. omz self-update is off (DISABLE_AUTO_UPDATE in dot_zshrc.tmpl)
# so the two updaters never fight over the exact tree.
# Pins chosen 2026-07-31 during the WSL migration.

[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/c5ba74cf02cce4c342153f79089100194f30940f.tar.gz"
    exact = true
    stripComponents = 1

# Custom plugins live inside the exact omz tree as their own externals — the
# pattern the chezmoi user guide documents for exactly this case.
[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/85919cd1ffa7d2d5412f6d3fe437ebdbeeec4fc5.tar.gz"
    exact = true
    stripComponents = 1

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/1d85c692615a25fe2293bdd44b34c217d5d2bf04.tar.gz"
    exact = true
    stripComponents = 1

[".oh-my-zsh/custom/plugins/zsh-claudecode-completion"]
    type = "archive"
    url = "https://github.com/wbingli/zsh-claudecode-completion/archive/a745cfb6910ebe861a6e695b7d4c30f5a838bf30.tar.gz"
    exact = true
    stripComponents = 1

[".vim_runtime"]
    type = "archive"
    url = "https://github.com/amix/vimrc/archive/46294d589d15d2e7308cf76c58f2df49bbec31e8.tar.gz"
    exact = true
    stripComponents = 1

{{/*
The compiled command guard, landed beside the hook that consults it. See
.chezmoidata/secret-guard.yaml for why it arrives as a release asset and why an
empty version declares no external at all: the hook's own shell splitter is the
floor, so a machine without this binary is guarded exactly as it was before.

The platform key gates the whole block. An unlisted os/arch would otherwise
render an empty checksum, and chezmoi treats that as "no checksum" rather than
as an error - an unverified download into a security hook.
*/}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- if and .secretGuard.version (hasKey .secretGuard.sha256 $platform) -}}
{{- $digest := index .secretGuard.sha256 $platform -}}
{{- if $digest }}

[".claude/hooks/secret-guard"]
    type = "file"
    executable = true
    url = "https://github.com/myprysm/dotfiles/releases/download/secret-guard-{{ .secretGuard.version }}/secret-guard-{{ $platform }}"
    checksum.sha256 = "{{ $digest }}"
{{- end }}
{{- end }}
