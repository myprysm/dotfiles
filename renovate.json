{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "chezmoi archive externals pinned by commit; the branch comes from the `# renovate: branch=` line above each url",
      "managerFilePatterns": ["/^home/\\.chezmoiexternal\\.toml\\.tmpl$/"],
      "matchStrings": [
        "# renovate: branch=(?<currentValue>\\S+)\\n\\s+url = \"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "kubeone pinned-release download",
      "managerFilePatterns": ["/^home/\\.chezmoiscripts/run_once_after_23-kubeone\\.sh\\.tmpl$/"],
      "matchStrings": ["KUBEONE_VERSION=\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubermatic/kubeone",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "uv tool pins (the `package:` field only; the `with:` pins mirror the work playbook)",
      "managerFilePatterns": ["/^home/\\.chezmoidata/packages\\.yaml$/"],
      "matchStrings": ["package: \"(?<depName>[\\w.-]+)==(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "hindsight-coding-agents npm pin",
      "managerFilePatterns": ["/^home/\\.chezmoidata/hindsight\\.yaml$/"],
      "matchStrings": ["version: \"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@vectorize-io/hindsight-coding-agents"
    }
  ],
  "packageRules": [
    {
      "description": "Flag major updates and hold them for approval on the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        ":warning: **Major update** — read the upstream changelog for breaking changes before merging."
      ]
    },
    {
      "description": "Commit scopes follow the AGENTS.md list, which allows one scope per commit",
      "matchFileNames": ["go.mod", ".github/workflows/release-secret-guard.yml"],
      "semanticCommitScope": "secret-guard"
    },
    {
      "matchFileNames": ["home/.chezmoidata/packages.yaml", "home/.chezmoiscripts/run_once_after_23-kubeone.sh.tmpl"],
      "semanticCommitScope": "packages"
    },
    {
      "matchFileNames": ["home/.chezmoiexternal.toml.tmpl"],
      "semanticCommitScope": "externals"
    },
    {
      "matchFileNames": ["home/.chezmoidata/hindsight.yaml"],
      "semanticCommitScope": "hindsight"
    },
    {
      "matchFileNames": [".github/workflows/renovate.yml"],
      "semanticCommitScope": "renovate"
    },
    {
      "description": "GitHub Actions: one pull request per workflow file, so a commit never spans two scopes",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/release-secret-guard.yml"],
      "groupName": "github-actions secret-guard",
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/renovate.yml"],
      "groupName": "github-actions renovate",
      "addLabels": ["ci"]
    },
    {
      "description": "kubeone drives the kubeone cluster in the infrastructure repo: the CLI moves with that cluster, not on its own",
      "matchPackageNames": ["kubermatic/kubeone"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "hindsight pin: the bump runbook's six checks run before the pin commit, and Renovate cannot recompute the tarball sha256",
      "matchPackageNames": ["@vectorize-io/hindsight-coding-agents"],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "**Manual steps required before merge:** follow `docs/runbooks/bump-hindsight-pin.md`. This PR changes only `version`; set `sha256` from Step 1 and run the six checks."
      ]
    },
    {
      "description": "Skills pin: only the operator moves it, through its runbook (symlinks, .chezmoiremove, collision check)",
      "matchDepNames": ["mattpocock/skills"],
      "semanticCommitScope": "skills",
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "**Manual steps required before merge:** follow `docs/runbooks/bump-skill-pin.md`. This PR changes only the sha; update the subject comment, the skill symlinks and `.chezmoiremove`, and run the collision check."
      ]
    }
  ]
}
